{
  "name": "vortexchat",
  "productName": "VortexChat",
  "version": "1.3.0",
  "description": "VortexChat standalone desktop chat client with integrated OBS Studio overlay server by PFT Studio",
  "main": "main.js",
  "author": {
    "name": "PFT Studio",
    "email": "artempft@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable --publish never",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.pftstudio.vortexchat",
    "productName": "VortexChat",
    "copyright": "Copyright © 2026 PFT Studio",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "auth.js",
      "provider.js",
      "preload.js",
      "index.html",
      "style.css",
      "twitch.js",
      "overlay.html",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VortexChat",
      "uninstallDisplayName": "VortexChat by PFT Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerSidebar": "assets/installerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "uninstallerSidebar": "assets/uninstallerSidebar.bmp",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FN1p/vortexchat-extension.git"
  }
}
