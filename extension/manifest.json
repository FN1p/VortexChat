{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "author": "PFT Studio",
  "version": "4.4.3",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://*.7tv.app/*",
    "https://*.7tv.io/*",
    "https://api.ivr.fi/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://cdn.frankerfacez.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "core.js",
        "cosmetics.js",
        "chat-tools.js",
        "content.js",
        "media.js",
        "visual-controls.js"
      ],
      "css": [
        "content.css",
        "media.css",
        "theme.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "all_frames": true,
      "js": [
        "core.js",
        "youtube-chat.js",
        "visual-controls.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "page-bridge.js"
      ],
      "matches": [
        "*://*.twitch.tv/*"
      ]
    }
  ],
  "version_name": "4.4.3 Beta 8",
  "default_locale": "ru"
}
